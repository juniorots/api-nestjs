generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// tipoCardapio: D - DIURNO / N - NOTURNO
// NOTA: Demais campos fora do escopo de uma POC...
model Produto {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  nome String? 
  tipoCardapio String? 
  categoriaId String 
  categoria Categoria @relation("CategoriaProdutos", fields: [categoriaId], references: [id])
}

model Categoria {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  nome String?
  produtos Produto[] @relation("CategoriaProdutos")
}

// NOTA: Cardapio é uma bifurcacao que nao carece de entidade, no contexto logico...